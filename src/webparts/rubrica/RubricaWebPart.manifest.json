{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx/client-side-web-part-manifest.schema.json",
  "id": "341d4f0d-d3da-4944-a215-d95f7f036cd5",
  "alias": "RubricaWebPart",
  "componentType": "WebPart",

  // The "*" signifies that the version should be taken from the package.json
  "version": "*",
  "manifestVersion": 2,

  // If true, the component can only be installed on sites where Custom Script is allowed.
  // Components that allow authors to embed arbitrary script code should set this to true.
  // https://support.office.com/en-us/article/Turn-scripting-capabilities-on-or-off-1f2c515f-5d7e-448a-9fd7-835da935584f
  "requiresCustomScript": false,
  "supportedHosts": ["SharePointWebPart", "TeamsPersonalApp", "TeamsTab", "SharePointFullPage"],
  "supportsThemeVariants": true,

  "preconfiguredEntries": [{
    "groupId": "5c03119e-3074-46fd-976b-c60198311f70", // Advanced
    "group": { "default": "Advanced" },
    "title": { "default": "Rubrica aziendale" },
    "description": { "default": "Rubrica telefonica aziendale: utenti, servizi interni e contatti esterni" },
    "officeFabricIconFontName": "ContactList",
    // Valori di default per le NUOVE istanze: devono coincidere con src/webparts/rubrica/proprieta.ts
    "properties": {
      "titolo": "",
      "placeholderRicerca": "Cerca per nome, reparto, interno...",
      "risultatiPerPagina": 30,
      "mostraElencoCompleto": false,
      "listaServizi": "Rubrica",
      "listaEsterni": "Esterni",
      "mostraEsterni": true,
      "esterniInizialmenteVisibili": true,
      "soloMembri": true,
      "nascondiSenzaMail": true,
      "nascondiSenzaTelefono": true,
      "mostraContatore": true,
      "mostraPresenza": true,
      "mostraReparto": true,
      "mostraCellulare": true,
      "linkCliccabili": true,
      "usaDatiMock": false
    }
  }]
}
